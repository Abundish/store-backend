# Staging environment — copy to .env on the staging server and fill in values
STORE_CORS=http://localhost:8000,https://staging.abundish.info,https://staging-api.abundish.info
ADMIN_CORS=http://localhost:5173,http://localhost:9001,https://staging-api.abundish.info
AUTH_CORS=http://localhost:5173,http://localhost:9001,https://staging-api.abundish.info
JWT_SECRET=
COOKIE_SECRET=
MEDUSA_BACKEND_URL=https://staging-api.abundish.info
NODE_ENV=production
# Enable RBAC (requires migrations + bootstrap script on first deploy)
MEDUSA_FF_RBAC=true
DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa-store-staging
REDIS_URL=redis://redis:6379
MEILISEARCH_MASTER_KEY=
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_SEARCH_KEY=
PAYSTACK_SECRET_KEY=sk_test_your_test_key_here
# Chowdeck — used to calculate delivery fees at checkout
# POST {CHOWDECK_RELAY_BASE_URL}/merchant/{CHOWDECK_MERCHANT_REF}/delivery/fee
CHOWDECK_RELAY_API_KEY=
CHOWDECK_RELAY_BASE_URL=https://api.chowdeck.com
CHOWDECK_MERCHANT_REF=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
# Comma-separated list of addresses that receive the new-order alert (not the customer confirmation)
ADMIN_NOTIFICATION_EMAIL=ops@abundish.info,kitchen@abundish.info
ADMIN_EMAIL=admin@abundish.info
